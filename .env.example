# Copy this file to .env and fill in your own values. .env is gitignored; never commit it.

# Garmin Connect Personal API key: https://connect.garmin.com/app/settings/personalApiToken
GARMIN_API_KEY=

# Optional: how many days to fetch (default 90)
# GARMIN_DAYS=90

# Optional: Grafana admin password, used the first time Grafana starts (default: admin)
# GRAFANA_ADMIN_PASSWORD=

# Optional: point the embedded Grafana section at a different URL (default: http://localhost:3000)
# VITE_GRAFANA_URL=http://localhost:3000
